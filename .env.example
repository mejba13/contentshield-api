APP_NAME="ContentShield AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=contentshield
DB_USERNAME=contentshield
DB_PASSWORD=

# SQLite for development
# DB_CONNECTION=sqlite

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@contentshield.ai"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# ContentShield AI Configuration
# ===========================================

CONTENTSHIELD_API_VERSION=1.0.0
CONTENTSHIELD_LICENSE_PREFIX=CSAI

# LemonSqueezy Payment Integration
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STARTER_VARIANT_ID=123456
LEMONSQUEEZY_PRO_VARIANT_ID=123457
LEMONSQUEEZY_AGENCY_VARIANT_ID=123458

# AI Provider Configuration
CONTENTSHIELD_AI_PROVIDER=openai
CONTENTSHIELD_AI_MODEL=gpt-4o-mini
CONTENTSHIELD_AI_MAX_TOKENS=1024
CONTENTSHIELD_AI_TEMPERATURE=0

# OpenAI API
OPENAI_API_KEY=

# Anthropic API (Alternative)
ANTHROPIC_API_KEY=

# Google Search API (for plagiarism scanning)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Monitoring Configuration
CONTENTSHIELD_MIN_SIMILARITY=50
CONTENTSHIELD_MAX_URLS_PER_SCAN=20
CONTENTSHIELD_FETCH_DELAY=500
CONTENTSHIELD_USER_AGENT="ContentShield/1.0 (+https://contentshield.ai)"
CONTENTSHIELD_FETCH_TIMEOUT=30

# DMCA Configuration
CONTENTSHIELD_DMCA_SENDER_NAME="ContentShield AI"
CONTENTSHIELD_DMCA_SENDER_EMAIL=dmca@contentshield.ai
CONTENTSHIELD_DMCA_REFERENCE_PREFIX=DMCA

# Queue Configuration
CONTENTSHIELD_QUEUE_MONITORING=monitoring
CONTENTSHIELD_QUEUE_DMCA=dmca
CONTENTSHIELD_QUEUE_DEFAULT=default

# Cache Configuration
CONTENTSHIELD_CACHE_LICENSE_TTL=300
CONTENTSHIELD_CACHE_FINGERPRINT_TTL=3600
